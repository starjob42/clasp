# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.venv_*/

# Tooling caches
.pytest_cache/
.ruff_cache/

# Run artifacts (never commit weights, datasets, or logs)
outputs/
inference/
wandb/
*.log

# Local data and model mounts
data/data_sft/
data/data_rl/
models/*/

# Checkpoint weights: keep the directory layout and manifests, not the tensors
checkpoints/**/*.safetensors
checkpoints/**/*.bin
checkpoints/**/*.pt
checkpoints/**/optimizer.pt
.aider*

# Large local artefact trees: never part of the published source snapshot.
experiments/**
analysis_outputs/
artifacts/
audit_ledgers_iclr/
checkpoints/
data/
logs/
models/
outputs/
paper/
research/
results/
third_party/**/data_rl/
final_clasp/work/
.opencode/
opencode.json
pytest-of-habgaryan/
checkpoint-*.zip
*.zip

# Local-only analysis helpers kept outside the packaged source tree.
/aggregate_baseline.py
/analyze_sft_failures.py
/audit_reference_solutions.py
/compare_sft_checkpoints.py
/prompt_lengths.py

# The budget-matched FOARL campaign is published: it is small, auditable source
# plus immutable evaluation evidence, not a local artifact tree.
!experiments/grpo_full_budget_20260918/
!experiments/grpo_full_budget_20260918/**
experiments/grpo_full_budget_20260918/**/__pycache__/
experiments/grpo_full_budget_20260918/**/*.pyc
experiments/grpo_full_budget_20260918/**/*.log
experiments/grpo_full_budget_20260918/.*.lock

# The budget-matched campaign's numerical audit helper is part of the published
# reproduction path; the surrounding external-baseline campaign tree is not.
!experiments/grpo_external_baseline_all_tasks_20260910/
experiments/grpo_external_baseline_all_tasks_20260910/*
!experiments/grpo_external_baseline_all_tasks_20260910/all_tasks_evaluation.py
